  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable code (unauthorized, conflict, preflight_failed, ...)."
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object"
          }
        }
      },
      "PairRequest": {
        "type": "object",
        "required": [
          "name",
          "public_key",
          "client_nonce",
          "proof"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Shown in the admin list, e.g. \"Pixel 9\"."
          },
          "public_key": {
            "type": "string",
            "description": "Base64 Ed25519 public key."
          },
          "client_nonce": {
            "type": "string",
            "description": "16-64 hex characters."
          },
          "proof": {
            "type": "string",
            "description": "Hex HMAC-SHA256(secret, `rp-pair-v1|client|<device>|<public_key>|<client_nonce>`)."
          }
        },
        "additionalProperties": false
      },
      "SignedEnvelope": {
        "type": "object",
        "description": "An admin-signed request (see the pairing and signing docs).",
        "required": [
          "admin_id",
          "nonce",
          "expires_at",
          "payload",
          "signature"
        ],
        "properties": {
          "admin_id": {
            "type": "string"
          },
          "nonce": {
            "type": "string",
            "description": "16-64 hex characters, never reused."
          },
          "expires_at": {
            "type": "integer",
            "format": "int64",
            "description": "Unix seconds, at most 300 s ahead."
          },
          "payload": {
            "type": "string",
            "description": "The operation, as a JSON string, e.g. `{\"op\":\"confirm\",\"id\":\"…\"}`."
          },
          "signature": {
            "type": "string",
            "description": "Base64 Ed25519 signature over `rp-admin-v1\\n<device>\\n<admin>\\n<nonce>\\n<expires>\\n<payload>`."
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "session": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
