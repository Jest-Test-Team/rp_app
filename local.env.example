# Copy to local.env (gitignored) and fill in real values.
PI_HOSTNAME=raspberrypi
PI_USER=CHANGE_ME
PI_PASSWORD=CHANGE_ME
WIFI_SSID=CHANGE_ME
WIFI_PASSWORD=CHANGE_ME
WIFI_COUNTRY=TW
# Whole-disk id of the SD card, from scripts/00-preflight.sh (e.g. disk5)
SD_DISK=CHANGE_ME
IMAGE_URL=https://downloads.raspberrypi.com/raspios_lite_armhf_latest
PI_PASSWORD=new_password_change_me