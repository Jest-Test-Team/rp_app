#!/usr/sbin/nft -f
# Managed by rpctl — local edits will be overwritten.

table inet rp
delete table inet rp

table inet rp {
	set ssh_allow4 {
		type ipv4_addr
		flags interval
		elements = { 192.0.2.0/24 }
	}
	set ssh_allow6 {
		type ipv6_addr
		flags interval
	}
	set lan4 {
		type ipv4_addr
		flags interval
		elements = { 192.0.2.0/24 }
	}
	set lan6 {
		type ipv6_addr
		flags interval
	}

	# Extension points: module snippets in /etc/rp/nft.d append here.
	# mod_prefilter runs before connection tracking accepts anything, so a
	# quarantine also cuts connections that were already established.
	chain mod_prefilter {
	}

	chain mod_input {
	}

	chain mod_forward {
	}

	chain input {
		type filter hook input priority filter; policy drop;
		jump mod_prefilter
		ct state established,related accept
		ct state invalid drop
		iif "lo" accept
		ip protocol icmp limit rate 20/second accept
		meta l4proto ipv6-icmp accept
		udp sport 67 udp dport 68 accept
		udp sport 547 udp dport 546 accept
		udp dport 5353 accept
		tcp dport 22 ip saddr @ssh_allow4 accept
		tcp dport 22 ip6 saddr @ssh_allow6 accept
		jump mod_input
		limit rate 10/minute burst 20 packets log prefix "rp-input-drop "
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
		jump mod_prefilter
		ct state established,related accept
		ct state invalid drop
		jump mod_forward
		limit rate 10/minute burst 20 packets log prefix "rp-forward-drop "
	}

	chain output {
		type filter hook output priority filter; policy accept;
	}
}

# Managed by rpctl — local edits will be overwritten.
# Access point wlan0: internet yes; LAN, peers and management no.
table inet rp {
	set ap_block4 {
		type ipv4_addr
		flags interval
		elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.2.0/24, 192.168.0.0/16, 224.0.0.0/3 }
	}
	set ap_allow4 {
		type ipv4_addr
		flags interval
	}
	set ap_quarantine4 {
		type ipv4_addr
		flags timeout
	}
	set ap_quarantine_mac {
		type ether_addr
		flags timeout
	}

	chain mod_prefilter {
		iifname "wlan0" ip saddr @ap_quarantine4 drop
		oifname "wlan0" ip daddr @ap_quarantine4 drop
		iifname "wlan0" ether saddr @ap_quarantine_mac drop
	}

	chain mod_input {
		iifname "wlan0" udp sport 68 udp dport 67 accept
	}

	chain mod_forward {
		iifname "wlan0" oifname "wlan0" drop
		iifname "wlan0" tcp dport 853 limit rate 6/minute log prefix "rp-ap-dot "
		iifname "wlan0" udp dport 853 limit rate 6/minute log prefix "rp-ap-doq "
		iifname "wlan0" oifname "eth0" ip daddr @ap_allow4 accept
		iifname "wlan0" ip daddr @ap_block4 drop
		iifname "wlan0" meta nfproto ipv6 drop
		iifname "wlan0" oifname "eth0" accept
		iifname "eth0" oifname "wlan0" ip saddr @lan4 accept
	}

	chain ap_postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		oifname "eth0" ip saddr 198.51.100.0/24 masquerade
	}
}
