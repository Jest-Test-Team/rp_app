# Managed by rpctl — local edits will be overwritten.
# Access point wlan0: internet yes; LAN, peers and management no.
table inet rp {
	set ap_block4 {
		type ipv4_addr
		flags interval
		elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.2.0/24, 192.168.0.0/16, 224.0.0.0/3 }
	}
	set ap_allow4 {
		type ipv4_addr
		flags interval
	}

	chain mod_input {
		iifname "wlan0" udp sport 68 udp dport 67 accept
	}

	chain mod_forward {
		iifname "wlan0" oifname "wlan0" drop
		iifname "wlan0" tcp dport 853 limit rate 6/minute log prefix "rp-ap-dot "
		iifname "wlan0" udp dport 853 limit rate 6/minute log prefix "rp-ap-doq "
		iifname "wlan0" oifname "eth0" ip daddr @ap_allow4 accept
		iifname "wlan0" ip daddr @ap_block4 drop
		iifname "wlan0" meta nfproto ipv6 drop
		iifname "wlan0" oifname "eth0" accept
		iifname "eth0" oifname "wlan0" ip saddr @lan4 accept
	}

	chain ap_postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		oifname "eth0" ip saddr 198.51.100.0/24 masquerade
	}
}
