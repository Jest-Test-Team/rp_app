# Managed by rpctl — local edits will be overwritten.
[Unit]
Description=rp edge gateway firewall (nftables)
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/rp/nftables.nft
ExecReload=/usr/sbin/nft -f /etc/rp/nftables.nft
# Re-add unexpired approved quarantines (a reload recreates the table).
ExecStartPost=-/usr/local/bin/rpctl quarantine-restore
ExecReload=-/usr/local/bin/rpctl quarantine-restore
ExecStop=-/usr/sbin/nft delete table inet rp

[Install]
WantedBy=sysinit.target
