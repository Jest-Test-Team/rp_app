#!/usr/sbin/nft -f
# Managed by rpctl — local edits will be overwritten.

table inet rp
delete table inet rp

table inet rp {
	set ssh_allow4 {
		type ipv4_addr
		flags interval
		elements = { 192.0.2.0/24 }
	}
	set ssh_allow6 {
		type ipv6_addr
		flags interval
	}
	set lan4 {
		type ipv4_addr
		flags interval
		elements = { 192.0.2.0/24 }
	}
	set lan6 {
		type ipv6_addr
		flags interval
	}

	# Extension points: module snippets in /etc/rp/nft.d append here.
	chain mod_input {
	}

	chain mod_forward {
	}

	chain input {
		type filter hook input priority filter; policy drop;
		ct state established,related accept
		ct state invalid drop
		iif "lo" accept
		ip protocol icmp limit rate 20/second accept
		meta l4proto ipv6-icmp accept
		udp sport 67 udp dport 68 accept
		udp sport 547 udp dport 546 accept
		udp dport 5353 accept
		tcp dport 22 ip saddr @ssh_allow4 accept
		tcp dport 22 ip6 saddr @ssh_allow6 accept
		jump mod_input
		limit rate 10/minute burst 20 packets log prefix "rp-input-drop "
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
		ct state established,related accept
		ct state invalid drop
		jump mod_forward
		limit rate 10/minute burst 20 packets log prefix "rp-forward-drop "
	}

	chain output {
		type filter hook output priority filter; policy accept;
	}
}

# Managed by rpctl — local edits will be overwritten.
# VPN exit node (Wireguard): internet yes, home LAN no.
table inet rp {
	set vpn_block4 {
		type ipv4_addr
		flags interval
		elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.2.0/24, 192.168.0.0/16, 224.0.0.0/3 }
	}
	set vpn_block6 {
		type ipv6_addr
		flags interval
		elements = { ::1/128, fc00::/7, fe80::/10, ff00::/8 }
	}
	set vpn_allow4 {
		type ipv4_addr
		flags interval
	}
	set vpn_allow6 {
		type ipv6_addr
		flags interval
	}

	chain mod_input {
		udp dport 51820 accept
	}

	chain mod_forward {
		iifname "wg0" oifname "eth0" ip daddr @vpn_allow4 accept
		iifname "wg0" oifname "eth0" ip6 daddr @vpn_allow6 accept
		iifname "wg0" ip daddr @vpn_block4 drop
		iifname "wg0" ip6 daddr @vpn_block6 drop
		iifname "wg0" oifname "eth0" accept
	}

	chain vpn_postrouting {
		type nat hook postrouting priority srcnat; policy accept;
		oifname "eth0" ip saddr 198.51.100.0/24 masquerade
	}
}
